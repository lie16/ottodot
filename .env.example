# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://odoo:zaq12wsx@localhost:5432/ottodot_booking?schema=public"
DB_HOST="localhost"
DB_PORT="5432"
DB_USER="odoo"
DB_PASSWORD="your_password_here"
DB_NAME="ottodot_booking"

# Application
NODE_ENV="development"
PORT="3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Prisma Engine Configurations (Offline/Local Execution)
PRISMA_SCHEMA_ENGINE_BINARY="./node_modules/.pnpm/@prisma+engines@5.22.0/node_modules/@prisma/engines/schema-engine-windows.exe"
PRISMA_QUERY_ENGINE_LIBRARY="./node_modules/.pnpm/@prisma+engines@5.22.0/node_modules/@prisma/engines/query_engine-windows.dll.node"
CHECKPOINT_DISABLE="1"
PRISMA_HIDE_UPDATE_MESSAGE="1"
